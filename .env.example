# Required
# Your Chess.com username used by the worker ingestion service.
CHESSCOM_USERNAME=your_chesscom_username

# Optional runtime and infrastructure overrides
POSTGRES_DB=chessmonitor
POSTGRES_USER=chess
POSTGRES_PASSWORD=chess
DB_PORT=5432
API_PORT=8080
WEB_PORT=5173
STOCKFISH_THREADS=8
STOCKFISH_DEPTH=16
VITE_API_BASE_URL=http://localhost:8080
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
